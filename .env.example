# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Anthropic Claude API Key (Optional: if empty, app runs in high-fidelity sandbox simulator)
ANTHROPIC_API_KEY=

# Supabase Database & Auth (Free Tier)
# Get these from your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your_anon_key

# Backend Service Role Key (Used ONLY on server in server.js, NEVER exposed to client/browser!)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your_service_role_key

# Optional: Deepgram API Key (for speech diarization)
DEEPGRAM_API_KEY=

# Dev flag: if false, skips email confirmation block during demo/dev testing
VITE_REQUIRE_EMAIL_CONFIRMATION=false

